#!/bin/bash
set -uo pipefail
shopt -s nullglob

if [[ $# -ne 1 || "$1" == --help || "$1" == -h ]]; then
  echo 'Usage: cprun <problem-id | path/to/solution.cpp>'
  echo 'Samples: <problem-id>/*.in and *.out, or beside the C++ source.'
  [[ $# -eq 1 && ( "$1" == --help || "$1" == -h ) ]] && exit 0
  exit 2
fi

if [[ "$1" == *.cpp ]]; then
  if [[ ! -f "$1" ]]; then
    echo "Source file not found: $1" >&2
    exit 2
  fi
  source_dir=$(cd "$(dirname "$1")" && pwd)
  source_file="$source_dir/$(basename "$1")"
  problem=$(basename "$1" .cpp | tr '[:lower:]' '[:upper:]')
  inputs=("$source_dir"/*.in)
  if [[ ${#inputs[@]} -gt 0 ]]; then
    sample_dir="$source_dir"
  else
    sample_dir="$source_dir/$problem"
  fi
else
  problem=$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')
  sample_dir="$PWD/$problem"
  source_file="$sample_dir/$problem.cpp"
fi

inputs=("$sample_dir"/*.in)
if [[ ${#inputs[@]} -eq 0 ]]; then
  echo "No input files in: $sample_dir" >&2
  exit 2
fi
if [[ ! -f "$source_file" ]]; then
  echo "Source file not found: $source_file" >&2
  exit 2
fi

compiler=${CXX:-}
if [[ -z "$compiler" ]]; then
  # Apple clang's g++ alias lacks the bits/stdc++.h used by these snippets.
  for candidate in /opt/homebrew/bin/g++-[0-9]* /usr/local/bin/g++-[0-9]*; do
    [[ -x "$candidate" ]] && compiler="$candidate"
  done
  compiler=${compiler:-g++}
fi
if ! command -v "$compiler" >/dev/null 2>&1; then
  echo "C++ compiler not found: $compiler" >&2
  exit 2
fi

build_dir=$(mktemp -d "${TMPDIR:-/tmp}/cprun.XXXXXX") || exit 2
trap 'rm -rf "$build_dir"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if ! "$compiler" -std=c++17 -Wall -fsanitize=undefined -O2 "$source_file" -o "$build_dir/solution"; then
  printf '\033[0;31m✘ Compilation Error\033[0m\n'
  exit 1
fi

correct=0
for input_file in "${inputs[@]}"; do
  expected_file="${input_file%.in}.out"
  sample=$(basename "$input_file" .in)
  if [[ ! -f "$expected_file" ]]; then
    printf '✘ Missing expected output for sample %s\n' "$sample"
    continue
  fi
  if ! "$build_dir/solution" < "$input_file" > "$build_dir/output"; then
    printf '\033[0;31m✘ Runtime Error in sample %s\033[0m\n' "$sample"
    continue
  fi
  if diff -u "$expected_file" "$build_dir/output" > "$build_dir/diff"; then
    printf '\033[0;32m✓ Passed sample %s!\033[0m\n' "$sample"
    correct=$((correct + 1))
  else
    printf '\033[0;31m✘ Failed sample %s!\033[0m\n' "$sample"
    cat "$build_dir/diff"
  fi
done

if [[ "$correct" -eq "${#inputs[@]}" ]]; then
  printf '\n\033[0;32m✓ Passed [%s/%s] tests\033[0m\n' "$correct" "${#inputs[@]}"
  exit 0
fi
printf '\n\033[0;31m✘ Passed [%s/%s] tests\033[0m\n' "$correct" "${#inputs[@]}"
exit 1
